# Copy this file to .env and fill in real values. Never commit .env.

# How often (seconds) the background poller checks every tracked job.
POLL_INTERVAL_SECONDS=300

# Port the dashboard listens on.
PORT=5000

# ntfy.sh push notifications (free, no signup required).
# 1. Pick a hard-to-guess topic name (anyone who knows it can read your
#    notifications, since public ntfy.sh topics aren't private by default).
# 2. Install the ntfy app (iOS/Android) or open https://ntfy.sh/<topic> in a
#    browser, and subscribe to that same topic name.
# 3. Set it here. Leave blank to fall back to desktop/console notifications only.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
